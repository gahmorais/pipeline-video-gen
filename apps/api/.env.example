# Copie para .env (não versionado) e ajuste.
HTTP_ADDR=:8080
DATABASE_URL=postgres://videogen:videogen@localhost:5432/videogen?sslmode=disable
MEDIA_DIR=../../media
# Token compartilhado com o render worker (endpoints /internal). Gere com: openssl rand -hex 32
INTERNAL_TOKEN=
CORS_ORIGIN=http://localhost:3000

# --- Roteiro (LLM) ---
# auto (padrão): Gemini + Anthropic → fallback; só uma chave → aquele provedor.
# fixture: sem custo, usa o JSON de STORYBOARD_FIXTURE (desenvolvimento).
STORYBOARD_PROVIDER=auto
STORYBOARD_WORKERS=2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Preços em USD por milhão de tokens (confira as tabelas oficiais):
# GEMINI_PRICE_INPUT=1.50
# GEMINI_PRICE_OUTPUT=9.00
# ANTHROPIC_PRICE_INPUT=4.00
# ANTHROPIC_PRICE_OUTPUT=20.00
# STORYBOARD_FIXTURE=../../packages/video-schema/fixtures/valid/promo-basic.json
